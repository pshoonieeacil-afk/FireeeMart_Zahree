PORT=5000

# ---------- Database MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=fireeemart

# Isi "true" untuk database cloud (TiDB Cloud, Aiven, Railway, dll) yang mewajibkan SSL
DB_SSL=false
# Opsional: isi CA certificate (PEM) jika provider mewajibkan, ganti baris baru dengan \n
DB_SSL_CA=

# ---------- Keamanan ----------
# WAJIB diganti dengan string acak panjang di production, mis. hasil:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=ganti-dengan-string-acak-yang-panjang

# ---------- Zona waktu ----------
APP_TIMEZONE=Asia/Jakarta
DB_TIMEZONE=+07:00

# Alamat frontend (hanya perlu jika frontend memanggil API langsung, bukan lewat proxy Next.js)
CORS_ORIGIN=http://localhost:3000
